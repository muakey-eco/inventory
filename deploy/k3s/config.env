# Cấu hình KHÔNG bí mật, vào ConfigMap `inventory-config`. Bí mật ở Infisical,
# kéo về qua `externalsecret.yaml`.
#
# Kustomize đọc nguyên văn: không bao giá trị trong ngoặc kép, không `${...}`.
# Đổi một dòng là ConfigMap mới (hash trong tên) và mọi pod rollout lại.

APP_NAME=Kho hàng số
APP_ENV=production
APP_DEBUG=false
# Cùng host với `ingress.yaml`.
APP_URL=https://kho.muakeyoffice.net

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en

# `artisan down` phải khoá mọi replica, không chỉ pod chạy lệnh.
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

# Không cần `TRUSTED_PROXIES`: kho tin mọi proxy ngay trong code
# (`bootstrap/app.php`, ADR 0009).

# Đọc bằng `kubectl logs`: không volume `storage` nào dùng chung giữa các pod,
# nên log ghi vào file là log mất theo pod. Nhật ký bảo mật nằm trong DB.
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Postgres NGOÀI cluster; chỉ mật khẩu ở Infisical.
DB_CONNECTION=pgsql
DB_HOST=postgres.muakeyoffice.net
DB_PORT=5432
DB_DATABASE=inventory
DB_USERNAME=inventory

# Ghim tên cookie và prefix cache: không ghim thì Laravel suy chúng từ
# APP_NAME, đổi tên hiển thị là đăng xuất mọi nhân viên.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=inventory-session

QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=inventory-cache-
BROADCAST_CONNECTION=log
MAIL_MAILER=log

INVENTORY_API_HOLD_MINUTES=15
INVENTORY_API_RATE_LIMIT=60

# Nhân viên đăng nhập qua platform (ADR 0011). App `inventory` đăng ký ở Admin
# console: redirect URI đúng nguyên văn PLATFORM_REDIRECT_URI, post-logout
# redirect URI là PLATFORM_POST_LOGOUT_REDIRECT_URI, `backchannel_logout_uri`
# là `http://web.inventory.svc:8000/admin/auth/backchannel-logout`.
PLATFORM_ISSUER=https://id.muakeyoffice.net/oidc
PLATFORM_CLIENT_ID=inventory
PLATFORM_REDIRECT_URI=https://kho.muakeyoffice.net/admin/auth/callback
PLATFORM_POST_LOGOUT_REDIRECT_URI=https://kho.muakeyoffice.net/
# `/v1` gọi thẳng Service trong cụm, không qua ingress.
PLATFORM_API_URL=http://core.platform.svc
# Phiên bản quyền đọc từ Redis của platform (`PLATFORM_REDIS_URL`, ghép trong
# `common.yaml`); quyền cache ở store mọi pod dùng chung, để thu quyền có hiệu
# lực ngay trên mọi replica.
PLATFORM_VERSION_SOURCE=redis
PLATFORM_CACHE_STORE=database

# Bucket private `muakey-inventory` trên versitygw (ADR 0009). Ba biến `*_DISK`
# rỗng là kho quay về ổ local, mà pod không giữ state cục bộ: đừng bỏ.
FILESYSTEM_DISK=local
AWS_ENDPOINT=https://s3.muakey.com
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=muakey-inventory
AWS_USE_PATH_STYLE_ENDPOINT=true
INVENTORY_INTAKE_DISK=s3
INVENTORY_DEFECT_SCREENSHOT_DISK=s3
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=s3
