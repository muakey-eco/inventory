APP_NAME="Kho hàng số"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Khoá mã hoá của kho, tách khỏi APP_KEY: "<phiên bản>:base64:<32 byte>".
# Khoá nội dung cũ (sau khi xoay) liệt kê trong INVENTORY_CONTENT_PREVIOUS_KEYS, phân tách bằng dấu phẩy.
INVENTORY_CONTENT_KEY=
INVENTORY_CONTENT_PREVIOUS_KEYS=
INVENTORY_HMAC_KEY=

# API xuất kho cho website: hạn Giữ hàng mặc định của Kênh bán loại API mới (phút)
# và số request mỗi phút cho mỗi Khoá API.
INVENTORY_API_HOLD_MINUTES=15
INVENTORY_API_RATE_LIMIT=60

# Nhân viên đăng nhập qua platform (ADR 0011, xem README mục "Đăng nhập qua platform"). Dev dùng
# App thử `inventory-dev` trên chính platform production, đăng nhập bằng tài khoản thật, nên cần
# VPN: `/v1` chỉ vào được qua VPN. Secret của `inventory-dev` nằm trong trình quản lý mật khẩu của
# team, không commit. PLATFORM_REDIRECT_URI phải khớp NGUYÊN VĂN redirect URI đã đăng ký.
PLATFORM_ISSUER=https://id.muakeyoffice.net/oidc
PLATFORM_API_URL=https://platform.muakeyoffice.net
PLATFORM_CLIENT_ID=inventory-dev
PLATFORM_CLIENT_SECRET=
PLATFORM_REDIRECT_URI="${APP_URL}/admin/auth/callback"
PLATFORM_POST_LOGOUT_REDIRECT_URI="${APP_URL}/"
# Redis của platform không ra ngoài cụm: đọc Phiên bản quyền qua Platform API.
PLATFORM_VERSION_SOURCE=api
PLATFORM_CACHE_STORE=
# App thử không nhận webhook: để trống, Bản sao danh bạ chỉ còn lệnh quét bù.
PLATFORM_WEBHOOK_SECRET=

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=inventory
DB_USERNAME=inventory
DB_PASSWORD=inventory

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Bucket S3-compatible trên k3s (ADR 0009), ví dụ AWS_ENDPOINT=https://s3.muakey.com,
# AWS_BUCKET=muakey-inventory, AWS_USE_PATH_STYLE_ENDPOINT=true. Bỏ trống ba biến *_DISK
# thì dev dùng ổ local như cũ.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# INVENTORY_INTAKE_DISK=s3
# INVENTORY_DEFECT_SCREENSHOT_DISK=s3
# LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=s3

VITE_APP_NAME="${APP_NAME}"
